# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to git.

# Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-secret-key-here

# Set to True for local development only. NEVER set True in production.
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database URL (leave blank to use local SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/apple_bank

# Cloudinary (for media file storage in production)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@nexuscustomerservice.online
EMAIL_HOST_PASSWORD=Basilstb123#
DEFAULT_FROM_EMAIL=info@nexuscustomerservice.online
